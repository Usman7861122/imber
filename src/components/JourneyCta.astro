---
import { site, contact } from '../data/site';
---
<section class="relative isolate overflow-hidden bg-ink text-white xl:min-h-[560px]" aria-labelledby="journey-title">
  <!-- Fixed-window parallax: the photo stays still while the page scrolls over it. -->
  <div class="h-[300px] overflow-hidden xl:absolute xl:inset-0 xl:-z-10 xl:h-auto xl:[clip-path:inset(0)]">
    <img src={contact.journeyPhoto} alt="" loading="lazy" class="size-full object-cover object-[60%_50%] xl:fixed xl:inset-0 xl:h-[100svh] xl:w-full" />
  </div>
  <div class="pointer-events-none absolute inset-0 -z-10 hidden bg-[linear-gradient(90deg,rgba(28,27,27,.92)_0%,rgba(28,27,27,.7)_38%,rgba(28,27,27,0)_70%)] xl:block" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-[1320px] items-center px-5 py-14 xl:min-h-[560px] xl:px-10 xl:py-20">
    <div class="max-w-[520px]">
      <p class="flex items-center gap-4 text-[11px] font-medium uppercase tracking-[0.34em] text-white/75">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>Your first visit
      </p>
      <h2 id="journey-title" class="mt-6 font-display text-[clamp(2.25rem,5vw,4rem)] leading-[1.08]">Start Your Aesthetic Journey Today</h2>
      <p class="mt-6 text-[17px] leading-relaxed text-white/80">Book your personalized consultation and experience expert care tailored to you.</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={site.bookUrl} class="inline-flex items-center justify-center gap-3 bg-gold px-10 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-black transition-colors hover:bg-white">
          Book online
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href={`tel:${site.phone}`} class="inline-flex items-center justify-center gap-3 border border-gold px-8 py-[15px] text-[12px] font-semibold uppercase tracking-[0.2em] text-white transition-colors hover:bg-gold hover:text-black"><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>Call {site.phone}</a>
      </div>
    </div>
  </div>
</section>
