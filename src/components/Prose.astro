---
// Readable long text (articles, legal pages).
const { html } = Astro.props as { html: string };
---
<div class="prose-imber" set:html={html} />
<style is:global>
  .prose-imber { color: #333; font-size: 17px; line-height: 1.8; }
  .prose-imber > * + * { margin-top: 1.25rem; }
  .prose-imber h2 { margin-top: 2.75rem; font-family: var(--font-display, 'Playfair Display', serif); font-size: clamp(1.6rem, 2.6vw, 2.1rem); line-height: 1.2; color: #1c1b1b; }
  .prose-imber h3 { margin-top: 2rem; font-family: var(--font-display, 'Playfair Display', serif); font-size: 1.4rem; line-height: 1.25; color: #1c1b1b; }
  .prose-imber ul, .prose-imber ol { padding-left: 1.4rem; }
  .prose-imber ul { list-style: none; }
  .prose-imber ul > li { position: relative; margin-top: .5rem; }
  .prose-imber ul > li::before { content: ''; position: absolute; left: -1.25rem; top: .8em; width: 7px; height: 7px; background: #c9af55; transform: rotate(45deg); }
  .prose-imber ol { list-style: decimal; }
  .prose-imber ol > li { margin-top: .5rem; padding-left: .25rem; }
  .prose-imber a { color: #1c1b1b; text-decoration: underline; text-decoration-color: #c9af55; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .prose-imber a:hover { color: #8a7326; }
  .prose-imber strong { color: #1c1b1b; }
</style>
