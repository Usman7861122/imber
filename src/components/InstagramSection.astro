---
import Icon from './Icon.astro';
import InstagramFeed from './islands/InstagramFeed';
import { instagram, samplePosts } from '../data/instagram';

const feedUrl = import.meta.env.PUBLIC_INSTAGRAM_FEED_URL as string | undefined;
---
<section class="border-t border-gold/40 bg-white py-24 xl:py-32" aria-labelledby="instagram-title">
  <div class="mx-auto grid max-w-[1320px] gap-12 px-5 xl:grid-cols-[1.1fr_1fr] xl:items-end xl:px-10">
    <div>
      <p class="flex items-center gap-4 text-[11px] font-medium uppercase tracking-[0.34em] text-ink/70">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>@{instagram.handle}
      </p>
      <h2 id="instagram-title" class="mt-6 font-display text-[clamp(2.5rem,5.4vw,4.5rem)] leading-[1.05] text-ink">Follow Along</h2>
      <p class="mt-6 max-w-md text-[17px] leading-relaxed text-ink/80">
        Treatment insights, client stories and everyday life at Imber, straight from Instagram.
      </p>
    </div>

    <!-- Profile card -->
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center xl:justify-end">
      <a href={instagram.url} class="flex items-center gap-4" aria-label={`@${instagram.handle} on Instagram`}>
        <img src={instagram.avatar} alt="" width="72" height="72" loading="lazy" class="size-[72px] shrink-0 rounded-img object-cover ring-2 ring-gold ring-offset-4 ring-offset-white" />
        <span class="block max-w-[260px]">
          <span class="block text-[15px] font-semibold text-ink">@{instagram.handle}</span>
          <span class="mt-1 block text-[13px] leading-5 text-ink/70">{instagram.bio}</span>
        </span>
      </a>
      <a
        href={instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-black px-8 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-gold transition-colors hover:bg-gold hover:text-black"
      >
        <Icon name="instagram" class="size-4" />Follow
      </a>
    </div>
  </div>

  <div class="mt-14">
    <InstagramFeed client:visible posts={samplePosts} feedUrl={feedUrl} />
  </div>
</section>
