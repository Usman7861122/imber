---
import { site } from '../data/site';
import NearbyLine from './NearbyLine.astro';
interface Props {
  title: string;
  eyebrow: string;
  lede: string;
  image: string;
  imageAlt: string;
  crumbs: { label: string; href?: string }[];
  position?: string;
  nearby?: boolean;
}
const { title, eyebrow, lede, image, imageAlt, crumbs, position = '50% 30%', nearby = false } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-ink text-white" aria-labelledby="page-title">
  <img src={image} alt={imageAlt} class="absolute inset-0 -z-20 size-full object-cover" style={`object-position:${position}`} loading="eager" />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(28,27,27,.94)_0%,rgba(28,27,27,.78)_45%,rgba(28,27,27,.25)_100%)] max-xl:bg-ink/80" aria-hidden="true"></div>
  {nearby && <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[55%] bg-gradient-to-t from-ink/90 via-ink/60 to-transparent" aria-hidden="true"></div>}
  <div class="pointer-events-none absolute -left-24 top-0 -z-10 size-[420px] rounded-full bg-gold/25 blur-[120px] drift-a" aria-hidden="true"></div>

  <div class="mx-auto max-w-[1320px] px-5 py-20 xl:px-10 xl:py-28">
    <nav aria-label="Breadcrumb" class="text-[12px] uppercase tracking-[0.2em] text-white/70">
      <ol class="flex flex-wrap items-center gap-x-3 gap-y-1">
        {crumbs.map((c, i) => (
          <li class="flex items-center gap-3">
            {i > 0 && <span class="h-px w-4 bg-gold" aria-hidden="true"></span>}
            {c.href ? <a href={c.href} class="transition-colors hover:text-gold">{c.label}</a> : <span class="text-gold" aria-current="page">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    <p class="mt-10 flex items-center gap-4 text-[11px] font-medium uppercase tracking-[0.34em] text-white/80">
      <span class="h-px w-10 bg-gold" aria-hidden="true"></span>{eyebrow}
    </p>
    <h1 id="page-title" class="mt-5 max-w-3xl font-display text-[clamp(2.75rem,6vw,5rem)] leading-[1.04]">{title}</h1>
    <p class="mt-6 max-w-xl text-[18px] leading-relaxed text-white/85">{lede}</p>
    <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a href={site.bookUrl} class="inline-flex items-center justify-center gap-3 bg-gold px-10 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-black transition-colors hover:bg-white">
        Book online
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a href={`tel:${site.phone}`} class="inline-flex items-center justify-center gap-3 border border-gold px-8 py-[15px] text-[12px] font-semibold uppercase tracking-[0.2em] text-white transition-colors hover:bg-gold hover:text-black"><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>Call {site.phone}</a>
    </div>
    {nearby && <div class="mt-12 xl:mt-16"><NearbyLine /></div>}
  </div>
</section>
