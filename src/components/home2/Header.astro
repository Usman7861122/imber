---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.webp';
import { site } from '../../data/site';
import Icon from '../Icon.astro';
import Stars from '../Stars.astro';
import MobileMenu from '../islands/MobileMenu';
import MegaMenu from './MegaMenu.astro';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const itemClass =
  'nav2 group/t relative flex cursor-pointer items-center gap-1.5 px-3 py-2 text-[12.5px] font-medium uppercase tracking-[0.14em] text-ink transition-colors hover:text-[#8a7326] data-[open=true]:text-[#8a7326] 2xl:px-4';
const mobileItems = site.menu.map((m) => ({
  label: m.label,
  href: m.href,
  children: m.mega?.groups.flatMap((g) => [{ label: g.title, href: g.href }, ...(g.links ?? [])]),
}));
---
<header class="relative z-40">
  <!-- Slim ink bar: offer on the left, contact on the right -->
  <div class="bg-[linear-gradient(90deg,#b9993f,#d6bf6c_50%,#b9993f)] text-[13px] font-medium text-ink">
    <div class="mx-auto flex max-w-[1400px] items-center justify-center gap-6 px-5 py-[9px] xl:justify-between xl:px-8">
      <a href={site.topbar.href} class="flex items-center gap-2 text-center hover:underline">
        <span class="h-1.5 w-1.5 shrink-0 rotate-45 bg-ink" aria-hidden="true"></span>{site.topbar.text}
      </a>
      <div class="hidden items-center gap-5 xl:flex">
        <a href={`tel:${site.phone}`} class="flex items-center gap-2 hover:underline"><Icon name="phone" class="size-3.5" />{site.phone}</a>
        <span class="h-3 w-px bg-ink/30" aria-hidden="true"></span>
        <div class="flex items-center gap-3">
          {site.social.filter((s) => s.icon !== 'phone').map((s) => (
            <a href={s.href} aria-label={s.label} class="transition-opacity hover:opacity-60"><Icon name={s.icon as 'facebook'} class="size-4" /></a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Main bar: frosted glass over the hero, solid white when a menu is open -->
  <div
    data-mega-root
    data-open="false"
    class:list={[
      'group/mega relative bg-white transition-[background-color,box-shadow] duration-300',
      overlay ? 'xl:fixed xl:inset-x-0 xl:top-[38px] xl:bg-white/80 xl:backdrop-blur-md xl:data-[stuck=true]:bg-white/97 xl:data-[stuck=true]:shadow-[0_10px_30px_-18px_rgba(0,0,0,.4)] xl:data-[open=true]:bg-white xl:data-[open=true]:backdrop-blur-none' : '',
    ]}
  >
    <span class="absolute inset-x-0 bottom-0 hidden h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent xl:block" aria-hidden="true"></span>
    <div class="mx-auto flex h-[76px] max-w-[1400px] items-center justify-between pr-[9px] xl:h-[88px] xl:px-8 xl:transition-[height] xl:duration-300 xl:group-data-[stuck=true]/mega:h-[72px]">
      <!-- Logo + name, on the left -->
      <a href="/" aria-label={`${site.name} home`} class="flex shrink-0 items-center gap-3">
        <Image src={logo} alt="" width={160} height={160} loading="eager" class="size-[64px] xl:size-[64px]" />
        <span class="font-display text-[19px] leading-none text-[#8a7326] xl:text-[22px]">{site.name}</span>
      </a>

      <!-- Navigation -->
      <nav class="hidden items-center xl:ml-8 xl:flex xl:flex-1 xl:justify-center" aria-label="Main">
        {site.menu.map((n) => (
          n.mega ? (
            <button type="button" data-mega-trigger={n.id} aria-expanded="false" aria-controls="mega-wrap" class={itemClass}>
              {n.label}
              <svg viewBox="0 0 24 24" class="size-3 transition-transform duration-300 group-data-[open=true]/t:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
          ) : (
            <a href={n.href} data-mega-link class={itemClass}>{n.label}</a>
          )
        ))}
      </nav>

      <!-- Rating + booking -->
      <div class="hidden shrink-0 items-center gap-6 xl:flex">
        <a href={site.rating.href} class="hidden items-center gap-2 text-[13px] text-ink 2xl:flex" aria-label={`${site.rating.score} stars, based on ${site.rating.count} reviews`}>
          <svg viewBox="0 0 24 24" class="size-4 text-gold" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" /></svg>
          <span class="font-semibold">{site.rating.score}</span>
          <span class="text-ink/60 underline decoration-gold underline-offset-4">{site.rating.count} reviews</span>
        </a>
        <a href={site.bookUrl} class="hbook group">
          <span class="hbook-in">
            <svg viewBox="0 0 24 24" class="size-4 text-gold transition-colors group-hover:text-ink" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
            Book now
            <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </div>

      <!-- Menu button (mobile / tablet) -->
      <div class="xl:hidden">
        <MobileMenu client:media="(max-width: 1279px)" items={mobileItems} />
      </div>
    </div>

    <!-- Soft dimmer behind an open menu -->
    <div class="pointer-events-none absolute inset-x-0 top-full -z-10 hidden h-[100vh] bg-ink/35 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 group-data-[open=true]/mega:opacity-100 xl:block" aria-hidden="true"></div>
    <MegaMenu items={site.menu} />
  </div>
</header>

<style is:global>
  @property --hb-a { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .hbook { position: relative; display: inline-block; padding: 2px; border-radius: 7px; background: conic-gradient(from var(--hb-a), #1c1b1b 0 55%, #c9af55 80%, #f1e2a3 92%, #1c1b1b); animation: hb-spin 3.2s linear infinite; box-shadow: 0 8px 22px -10px rgba(28,27,27,.55); }
  @keyframes hb-spin { to { --hb-a: 360deg; } }
  .hbook-in { display: inline-flex; align-items: center; gap: 10px; border-radius: 5px; background: #1c1b1b; color: #fff; padding: 13px 24px; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; transition: background .25s, color .25s; }
  .hbook:hover .hbook-in { background: #c9af55; color: #1c1b1b; }
  @media (prefers-reduced-motion: reduce) { .hbook { animation: none; } }
  .nav2::after { content: ''; position: absolute; left: 50%; right: 50%; bottom: 2px; height: 1px; background: #c9af55; transition: left .3s, right .3s; }
  .nav2:hover::after, .nav2[data-open='true']::after { left: 12px; right: 12px; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mega-root]');
  if (root) {
    const wrap = root.querySelector<HTMLElement>('[data-mega-wrap]')!;
    const panels = [...root.querySelectorAll<HTMLElement>('[data-mega-panel]')];
    const triggers = [...root.querySelectorAll<HTMLElement>('[data-mega-trigger]')];
    // Sticky: the bar follows the scroll; it slides up to the very top once the gold bar has gone
    const place = () => {
      if (getComputedStyle(root).position !== 'fixed') return;
      root.style.top = Math.max(0, 38 - window.scrollY) + 'px';
      root.dataset.stuck = String(window.scrollY > 38);
    };
    place();
    window.addEventListener('scroll', place, { passive: true });
    window.addEventListener('resize', place);
    let current: string | null = null;
    let closeTimer: number | undefined;
    let openTimer: number | undefined;

    const sync = (id: string | null) => {
      panels.forEach((p) => {
        const on = p.dataset.megaPanel === id;
        p.dataset.active = String(on);
        (p as any).inert = !on;
      });
      triggers.forEach((t) => {
        const on = t.dataset.megaTrigger === id;
        t.setAttribute('aria-expanded', String(on));
        t.dataset.open = String(on);
      });
    };
    const show = (id: string) => {
      clearTimeout(closeTimer);
      if (id === current) return;
      current = id;
      sync(id);
      const panel = panels.find((p) => p.dataset.megaPanel === id)!;
      wrap.style.height = panel.offsetHeight + 'px';
      wrap.dataset.open = 'true';
      root.dataset.open = 'true';
    };
    const hide = () => {
      clearTimeout(openTimer);
      current = null;
      sync(null);
      wrap.style.height = '0px';
      wrap.dataset.open = 'false';
      root.dataset.open = 'false';
    };
    const later = () => {
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(hide, 180);
    };

    triggers.forEach((t) => {
      const id = t.dataset.megaTrigger!;
      t.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        clearTimeout(openTimer);
        // switch instantly when a panel is already open, small delay when opening from closed
        if (current) show(id);
        else openTimer = window.setTimeout(() => show(id), 70);
      });
      t.addEventListener('click', (e) => {
        if (current === id) return hide();
        show(id);
        if ((e as MouseEvent).detail === 0) panels.find((p) => p.dataset.megaPanel === id)?.querySelector<HTMLElement>('a')?.focus();
      });
    });
    root.querySelectorAll('[data-mega-link]').forEach((l) => l.addEventListener('mouseenter', () => { clearTimeout(openTimer); if (current) later(); }));
    root.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    root.addEventListener('mouseleave', () => { clearTimeout(openTimer); if (current) later(); });
    root.addEventListener('focusout', (e) => {
      if (current && !root.contains((e as FocusEvent).relatedTarget as Node)) hide();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current) {
        const id = current;
        hide();
        triggers.find((t) => t.dataset.megaTrigger === id)?.focus();
      }
    });
    window.addEventListener('resize', () => current && (wrap.style.height = panels.find((p) => p.dataset.megaPanel === current)!.offsetHeight + 'px'));
  }
</script>
