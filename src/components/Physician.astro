---
import { Image } from 'astro:assets';
import banner from '../assets/2nd-banner.png';

const creds = [
  { t: 'Board certified', d: 'Family and geriatric medicine', i: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.3 6.8 19l1-5.8L3.5 9.2l5.9-.9z' },
  { t: 'Aesthetic medicine', d: 'Certified in aesthetics and anti-aging by the AAPM', i: 'M12 3c3 3 6 5.5 6 9a6 6 0 0 1-12 0c0-3.5 3-6 6-9z' },
  { t: 'Trained worldwide', d: 'UNC Wilmington, Roehampton in London, and clinical studies in New York', i: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z' },
];
---
<section class="phys2 relative isolate overflow-hidden bg-[linear-gradient(180deg,#fff,#f8f4ea_55%,#fff)] py-20 xl:py-28">
  <div class="mx-auto grid max-w-[1240px] items-center gap-14 px-6 xl:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] xl:gap-24 xl:px-8">
    <!-- Photo, framed -->
    <div class="phys2-r relative mx-auto w-full max-w-[520px] xl:max-w-none">
      <div class="absolute -bottom-5 -left-5 right-5 top-5 rounded-img border border-gold/70" aria-hidden="true"></div>
      <div class="group/img relative overflow-hidden rounded-img shadow-[0_30px_60px_-30px_rgba(28,27,27,.55)]">
        <Image
          src={banner}
          alt="Dr. Laura Slack and her husband in the Imber Medical treatment room"
          widths={[700, 1100, 1500]}
          sizes="(min-width:1280px) 520px, 90vw"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover object-[0%_50%] transition-transform duration-[1200ms] ease-out group-hover/img:scale-[1.04]"
        />
      </div>
      <!-- Floating badge -->
      <div class="phys2-badge absolute right-3 bottom-8 max-w-[230px] rounded-img border border-gold/40 bg-white px-5 py-4 shadow-[0_20px_40px_-18px_rgba(28,27,27,.45)] xl:-right-10">
        <p class="font-display text-[20px] leading-tight text-ink">Imber Medical</p>
        <p class="mt-1 text-[12px] uppercase tracking-[0.16em] text-[#8a7326]">St. Simons Island, GA</p>
      </div>
    </div>

    <!-- Words -->
    <div class="phys2-r text-center xl:text-left" style="--d:.12s">
      <p class="flex items-center justify-center gap-3 text-[12px] font-medium uppercase tracking-[0.26em] text-[#8a7326] xl:justify-start">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>Meet your physician
      </p>
      <h2 class="mt-5 font-display text-[40px] leading-[1.08] text-ink xl:text-[58px]">
        Laura Slack, <span class="text-[#b39a45]">MD</span>
      </h2>
      <p class="mt-3 text-[17px] font-medium text-ink/80 xl:text-[19px]">Board-certified physician in family, geriatric and aesthetic medicine</p>

      <p class="mx-auto mt-7 max-w-[560px] text-[16.5px] leading-[1.75] text-ink/75 xl:mx-0 xl:text-[17.5px]">
        Dr. Slack studied with honors at UNC Wilmington and at Roehampton University in London. She completed her medical studies abroad and her clinical training in New York, with elective and mission work in China, the West Indies and West Africa.
      </p>
      <p class="mx-auto mt-4 max-w-[560px] text-[16.5px] leading-[1.75] text-ink/75 xl:mx-0 xl:text-[17.5px]">
        Today she brings that medical depth to every treatment, so your care is safe, personal and planned around you.
      </p>

      <ul class="mt-9 grid gap-3 text-left">
        {creds.map((c) => (
          <li class="group/c flex items-start gap-4 rounded-img border border-gold/30 bg-[linear-gradient(135deg,rgba(255,255,255,.9),rgba(248,240,214,.55))] p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/60 hover:shadow-[0_16px_30px_-20px_rgba(28,27,27,.4)]">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[linear-gradient(135deg,#d6bf6c,#b9993f)] text-ink shadow-[0_8px_18px_-8px_rgba(185,153,63,.8)] transition-transform duration-300 group-hover/c:scale-110">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.i} /></svg>
            </span>
            <span>
              <span class="block font-display text-[19px] leading-tight text-ink">{c.t}</span>
              <span class="mt-0.5 block text-[14.5px] leading-snug text-ink/65">{c.d}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-4 xl:justify-start">
        <a href="/contact-us" class="phys2-btn group inline-flex items-center gap-3 rounded-[5px] bg-[linear-gradient(135deg,#d6bf6c,#b9993f)] px-8 py-4 text-[12.5px] font-semibold uppercase tracking-[0.18em] text-ink shadow-[0_14px_28px_-14px_rgba(185,153,63,.9)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_18px_34px_-14px_rgba(185,153,63,1)]">
          Book a consultation
          <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="/about" class="group inline-flex items-center gap-2 border-b border-gold pb-1 text-[12.5px] font-semibold uppercase tracking-[0.18em] text-ink transition-colors hover:text-[#8a7326]">
          Read her story
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .phys2-r { opacity: 0; transform: translateY(28px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0s); }
  .phys2-r.is-in { opacity: 1; transform: none; }
  .phys2-badge { animation: phys2-float 6s ease-in-out infinite; }
  @keyframes phys2-float { 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .phys2-r { opacity: 1; transform: none; transition: none; } .phys2-badge { animation: none; } }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('.phys2-r');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.15 });
    els.forEach((el) => io.observe(el));
  } else els.forEach((el) => el.classList.add('is-in'));
</script>
