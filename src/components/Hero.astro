---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';
import { site } from '../data/site';
import Icon from './Icon.astro';
const words = ['Skin rejuvenation', 'Laser hair removal', 'Hormone therapy', 'Medical weight loss', 'Botox & fillers', 'Body contouring'];
---
<section class="hero2 relative isolate bg-ink xl:min-h-[100svh] xl:overflow-hidden xl:rounded-br-[150px]">
  <!-- Same photo as before -->
  <div class="relative h-[250px] overflow-hidden xl:absolute xl:inset-0 xl:-z-20 xl:h-auto">
    <Image
      src={hero}
      alt="Dr. Laura Slack in the Imber Medical treatment room"
      widths={[900, 1400, 1950]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[74%_0%] max-xl:origin-[74%_28%] max-xl:scale-[2.2] max-xl:-translate-x-[24%] xl:object-[100%_0%]"
    />
  </div>
  <!-- Deep ink fade on the left, so white and gold text stay sharp -->
  <div class="absolute inset-0 -z-10 hidden bg-[linear-gradient(90deg,rgba(28,27,27,.82)_0%,rgba(28,27,27,.6)_28%,rgba(28,27,27,.22)_44%,transparent_56%)] xl:block" aria-hidden="true"></div>

  <div class="mx-auto flex w-full max-w-[1240px] xl:min-h-[100svh] xl:items-center xl:px-8 xl:pb-[70px] xl:pt-[170px]">
    <div class="w-full px-6 py-12 text-left xl:max-w-[640px] xl:p-0">
      <p class="hero2-in flex items-center gap-3 text-[13px] font-medium uppercase tracking-[0.22em] text-gold" style="--d:.05s">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
        Medical aesthetics · St. Simons Island, GA
      </p>

      <h1 class="hero2-in mt-5 font-display text-[40px] leading-[1.12] text-white xl:text-[60px]" style="--d:.15s">
        <span class="block">Physician-led</span>
        <span class="rot relative block text-gold" data-rotator aria-live="off">
          {words.map((w, i) => <span class:list={['rot-word', i === 0 && 'is-on']} aria-hidden={i === 0 ? 'false' : 'true'}>{w}</span>)}
        </span>
        <span class="block">in the Golden Isles</span>
      </h1>

      <p class="hero2-in mt-6 max-w-[500px] text-[18px] leading-[1.65] text-white/80 xl:text-[20px]" style="--d:.3s">
        Look radiant. Feel empowered. {site.description}
      </p>

      <div class="hero2-in mt-9 flex flex-wrap items-center gap-4" style="--d:.45s">
        <a href={site.bookUrl} class="btn-glow group">
          <span class="btn-glow-in">
            Book now
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        <a href={`tel:${site.phone}`} class="btn-ghost">
          <Icon name="phone" class="h-[18px] w-[18px] text-gold" />
          {site.phone}
        </a>
      </div>

      <ul class="hero2-in mt-9 flex flex-wrap gap-x-7 gap-y-2 text-[14px] text-white/70" style="--d:.6s">
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>Board certified</li>
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>4.9 stars · 169 reviews</li>
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>1620 Frederica Road</li>
      </ul>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-x-0 top-0 z-[1] h-[200px] bg-gradient-to-b from-ink/60 to-transparent max-xl:hidden" aria-hidden="true"></div>
</section>

<style is:global>
  @keyframes hero2-up { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  .hero2 h1, .hero2 p { text-shadow: 0 2px 18px rgba(0,0,0,.45); }
  .hero2-in { opacity: 0; animation: hero2-up .8s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: var(--d, 0s); }

  /* Rotating keyword: every word stays in the page for search engines, one shows at a time */
  .rot { display: grid; }
  .rot-word { grid-area: 1 / 1; white-space: nowrap; opacity: 0; transform: translateY(40%); filter: blur(6px); transition: opacity .6s, transform .6s cubic-bezier(.2,.7,.2,1), filter .6s; }
  .rot-word.is-on { opacity: 1; transform: none; filter: none; }
  .rot-word.is-out { opacity: 0; transform: translateY(-40%); filter: blur(6px); }

  /* Book now: gold button with a light that travels around the border */
  @property --hero-a { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .btn-glow { position: relative; display: inline-block; padding: 2px; border-radius: 6px; background: conic-gradient(from var(--hero-a), rgba(201,175,85,.25) 0 55%, #fff 80%, #c9af55 92%, rgba(201,175,85,.25)); animation: hero-spin 3.2s linear infinite; box-shadow: 0 10px 30px -10px rgba(201,175,85,.55); }
  @keyframes hero-spin { to { --hero-a: 360deg; } }
  .btn-glow-in { display: inline-flex; align-items: center; gap: 12px; border-radius: 4px; background: #c9af55; color: #1c1b1b; padding: 17px 34px; font-size: 16px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; transition: background .25s; }
  .btn-glow:hover .btn-glow-in { background: #d8c26f; }
  .btn-ghost { display: inline-flex; align-items: center; gap: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.06); backdrop-filter: blur(6px); color: #fff; padding: 18px 28px; font-size: 16px; font-weight: 500; letter-spacing: .02em; transition: background .25s, border-color .25s; }
  .btn-ghost:hover { background: rgba(255,255,255,.14); border-color: #c9af55; }

  @media (prefers-reduced-motion: reduce) {
    .hero2-in { opacity: 1; animation: none; }
    .btn-glow { animation: none; }
    .rot-word { transition: none; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-rotator]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...el.querySelectorAll<HTMLElement>('.rot-word')];
    let i = 0;
    setInterval(() => {
      const cur = words[i];
      i = (i + 1) % words.length;
      const next = words[i];
      cur.classList.remove('is-on'); cur.classList.add('is-out'); cur.setAttribute('aria-hidden', 'true');
      next.classList.remove('is-out'); next.classList.add('is-on'); next.setAttribute('aria-hidden', 'false');
      setTimeout(() => { cur.classList.remove('is-out'); }, 700);
    }, 2800);
  }
</script>
