---
// 4.9 of 5 gold stars (140 x 24, same as the live badge)
const star = 'M12 .6l3.4 7.2 7.8 1-5.7 5.4 1.5 7.8L12 18.2l-7 3.8 1.5-7.8L.8 8.8l7.8-1z';
---
<svg role="img" aria-label="4.9 out of 5 stars" width="140" height="24" viewBox="0 0 140 24" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="star-part"><stop offset="90%" stop-color="#fbbc04" /><stop offset="90%" stop-color="#d9d9d9" /></linearGradient>
  </defs>
  {[0, 1, 2, 3].map((n) => <path transform={`translate(${n * 29} 0)`} d={star} fill="#fbbc04" />)}
  <path transform="translate(116 0)" d={star} fill="url(#star-part)" />
</svg>
