---
import ProductCarousel from './islands/ProductCarousel';
import { products, productsIntro, PRODUCT_IMG_BASE, PRODUCTS_URL } from '../data/products';

const items = products.map(({ name, kind, file }) => ({ name, kind, image: PRODUCT_IMG_BASE + file }));
---
<section
  id="products"
  class="relative isolate overflow-hidden bg-[linear-gradient(160deg,#2a2826_0%,#1c1b1b_55%,#000_100%)] py-24 text-white xl:py-32 [--pad:1.25rem] xl:[--pad:max(2.5rem,calc((100vw_-_1320px)/2_+_2.5rem))]"
  aria-labelledby="products-title"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="drift-a absolute -left-24 top-[8%] size-[520px] rounded-full bg-gold/25 blur-[130px]"></div>
    <div class="drift-b absolute -right-24 bottom-[6%] size-[560px] rounded-full bg-gold/15 blur-[140px]"></div>
  </div>

  <div class="mx-auto flex max-w-[1320px] flex-col gap-8 px-5 xl:flex-row xl:items-end xl:justify-between xl:px-10">
    <div class="max-w-2xl">
      <p class="flex items-center gap-4 text-[11px] font-medium uppercase tracking-[0.34em] text-white/70">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>Take it home
      </p>
      <h2 id="products-title" class="mt-6 font-display text-[clamp(2.5rem,5.4vw,4.5rem)] leading-[1.05]">{productsIntro.title}</h2>
      <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-white/75">{productsIntro.text}</p>
    </div>
    <a
      href={PRODUCTS_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-fit items-center justify-center gap-3 bg-gold px-10 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-black transition-colors hover:bg-white"
    >
      View all products
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>

  <div class="mt-14 xl:mt-16">
    <ProductCarousel client:visible items={items} href={PRODUCTS_URL} />
  </div>
</section>
