---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
---
<BaseLayout title="Page not found">
  <Section>
    <h1 class="font-display text-4xl text-ink">Page not found</h1>
    <p class="mt-4"><a href="/" class="inline-flex items-center justify-center border border-gold bg-gold px-10 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-black transition-colors hover:bg-black hover:text-gold">Go to the home page</a></p>
  </Section>
</BaseLayout>
