---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Prose from '../../components/Prose.astro';
import { articles } from '../../data/articles';
import { site } from '../../data/site';
import { localCity } from '../../data/treatments';

export function getStaticPaths() {
  return articles.map((a, i) => ({ params: { slug: a.slug }, props: { a, more: articles.filter((_, k) => k !== i).slice(0, 3) } }));
}
const { a, more } = Astro.props;
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: a.title,
  datePublished: a.date,
  image: new URL(a.image, Astro.site).href,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<BaseLayout title={a.title} description={a.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero
    title={a.title}
    eyebrow={fmt(a.date)}
    lede={`Expert insights from the team at Imber Medical in ${localCity}.`}
    image={a.image}
    imageAlt=""
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Articles', href: '/articles/' }, { label: 'Article' }]}
  />
  <article class="bg-white py-16 xl:py-24">
    <div class="mx-auto max-w-3xl px-5 xl:px-0">
      <Prose html={a.html} />
      <div class="mt-14 flex flex-wrap items-center gap-4 border-t border-gold/40 pt-10">
        <a href={site.bookUrl} class="inline-flex items-center justify-center gap-3 bg-gold px-10 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-black transition-colors hover:bg-black hover:text-gold">Book a consultation</a>
        <a href={`tel:${site.phone}`} class="inline-flex items-center justify-center gap-3 border border-gold px-8 py-[15px] text-[12px] font-semibold uppercase tracking-[0.2em] text-ink transition-colors hover:bg-gold/20">Call {site.phone}</a>
      </div>
    </div>
  </article>
  <section class="bg-[linear-gradient(180deg,#fff_0%,rgba(201,175,85,.1)_100%)] py-16 xl:py-20" aria-labelledby="more-title">
    <div class="mx-auto max-w-[1320px] px-5 xl:px-10">
      <h2 id="more-title" class="font-display text-[clamp(1.75rem,3.2vw,2.5rem)] text-ink">More articles</h2>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        {more.map((m) => (
          <li>
            <a href={`/articles/${m.slug}/`} class="group block">
              <div class="aspect-[4/3] overflow-hidden rounded-img bg-ink"><img src={m.image} alt="" loading="lazy" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
              <h3 class="mt-4 font-display text-[21px] leading-snug text-ink group-hover:text-[#8a7326]">{m.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
