---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { reviews } from '../data/reviews';
import { site } from '../data/site';
import { localCity } from '../data/treatments';

const title = 'Patient Testimonials';
const description = `Read what patients say about Imber Medical in ${localCity}. ${site.rating.score} out of 5 stars from ${site.rating.count} Google reviews.`;
const reviewUrl = 'https://g.page/r/CYSytbwfKMB5EBM/review';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: site.name,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.score, reviewCount: site.rating.count },
  review: reviews.map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.author }, reviewRating: { '@type': 'Rating', ratingValue: r.rating }, reviewBody: r.text })),
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero
    title="Testimonials"
    eyebrow={`Patient stories · ${localCity}`}
    lede="Kind words from the people we care for, shared on Google."
    image="/images/team.jpg"
    imageAlt="The Imber Medical team: Dr. Laura Slack and her staff"
    position="50% 4%"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Resources' }, { label: 'Testimonials' }]}
  />
  <section class="relative isolate overflow-hidden bg-[linear-gradient(180deg,#fff_0%,rgba(201,175,85,.12)_55%,#fff_100%)] py-16 xl:py-24" aria-labelledby="rev-title">
    <div class="mx-auto max-w-[1320px] px-5 xl:px-10">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.34em] text-gold">In their own words</p>
        <h2 id="rev-title" class="mt-5 font-display text-[clamp(2rem,4.2vw,3.25rem)] leading-[1.08] text-ink">{site.rating.score} out of 5 on Google</h2>
        <p class="mt-4 text-[15px] text-ink/70">Based on <a href={site.rating.href} target="_blank" rel="noopener noreferrer" class="underline decoration-gold decoration-2 underline-offset-4 hover:text-black">{site.rating.count} reviews</a></p>
      </div>
      <ul class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {reviews.map((r) => (
          <li class="flex flex-col rounded-img border border-gold/40 bg-white p-8 shadow-[0_24px_50px_-34px_rgba(28,27,27,.45)]">
            <div class="flex items-center gap-1 text-gold" role="img" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" /></svg>)}
            </div>
            <blockquote class="mt-5 flex-1 text-[16px] leading-relaxed text-ink/85">“{r.text}”</blockquote>
            <p class="mt-6 border-t border-gold/30 pt-4 text-[13px] font-semibold uppercase tracking-[0.18em] text-ink">{r.author}<span class="ml-2 font-normal normal-case tracking-normal text-ink/55">· {r.when}</span></p>
          </li>
        ))}
      </ul>
      <div class="mt-14 flex flex-wrap items-center justify-center gap-4">
        <a href={reviewUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-gold px-10 py-4 text-[12px] font-semibold uppercase tracking-[0.26em] text-black transition-colors hover:bg-black hover:text-gold">Write a review</a>
        <a href={site.rating.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border border-gold px-10 py-[15px] text-[12px] font-semibold uppercase tracking-[0.22em] text-ink transition-colors hover:bg-gold/20">See all on Google</a>
      </div>
    </div>
  </section>
</BaseLayout>
