# Live Instagram feed (JSON). Example: a Behold.so feed URL for @imbermedicalssi.
# Leave empty to show the stand-in posts.
PUBLIC_INSTAGRAM_FEED_URL=

# Live Google reviews (JSON). Google Places API (New) place-details shape, or
# { "rating": 4.9, "total": 169, "reviews": [{ "author": "...", "text": "...", "rating": 5 }] }
PUBLIC_GOOGLE_REVIEWS_URL=

# Optional: where the contact form posts (Formspree, Basin, your own endpoint). Empty = opens the visitor email app.
PUBLIC_CONTACT_FORM_URL=
